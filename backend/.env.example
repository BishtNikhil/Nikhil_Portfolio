# ═══════════════════════════════════════════════════════════════
# Portfolio API Gateway — Environment Variables
# ═══════════════════════════════════════════════════════════════
#
# HOW TO USE:
#   1. Copy this file to .secrets.env:   cp .env.example .secrets.env
#   2. Fill in your real API keys in .secrets.env
#   3. Deploy with:                      npm run deploy
#
# The deploy script reads .secrets.env and injects keys directly
# into Cloud Run with zero Secret Manager charges.
# .secrets.env is gitignored — your keys never leave your machine.
#
# ═══════════════════════════════════════════════════════════════

# Generative AI API Key (Google AI / Gemini) — REQUIRED for AI Twin
GEMINI_API_KEY=your_gemini_api_key_here

# GitHub Personal Access Token — increases API rate limit to 5000/hr
GITHUB_TOKEN=your_github_pat_here

# WakaTime API Key — powers the Language Usage tracker
WAKATIME_API_KEY=your_wakatime_api_key_here

# Vertex AI Vector Search (optional — only needed for Vertex AI Index)
VERTEX_ENDPOINT_DOMAIN=
VERTEX_INDEX_ENDPOINT_ID=
VERTEX_DEPLOYED_INDEX_ID=
